# Supabase 데이터베이스 주소 (Supabase 연결 안내서 2단계에서 복사)
# 비워 두면 내 컴퓨터 안의 연습용 데이터베이스(.data 폴더)를 씁니다.
DATABASE_URL=

# (선택) 첫 설정 화면을 아무나 열지 못하게 하는 코드. 인터넷에 배포할 때 꼭 넣으세요.
SETUP_CODE=

# (선택) 개인정보 처리방침(/privacy)에 보일 운영자와 연락 방법. 개인 전화번호 대신 학교 연락처를 권해요.
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
# (선택) 데이터베이스를 서울이 아닌 곳에 만들었다면 그 위치(예: 싱가포르). 비우면 '대한민국(서울)'.
PRIVACY_DB_LOCATION=
